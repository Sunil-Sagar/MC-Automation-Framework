{
  "editor.fontSize": 14,
  "editor.wordWrap": "on",
  "editor.formatOnSave": false,
  "files.autoSave": "off",
  "editor.rulers": [72],
  "explorer.confirmDelete": true,
  "explorer.confirmDragAndDrop": true,
  "files.exclude": {
    "**/.git": true,
    "**/target": true,
    "**/*.class": true
  },
  "search.exclude": {
    "**/target": true,
    "**/*.class": true
  }
}
